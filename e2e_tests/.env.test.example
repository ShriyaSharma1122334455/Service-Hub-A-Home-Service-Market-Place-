# Copy this to .env.test and fill in your values
# Do NOT commit .env.test — it contains credentials

# ── Service URLs ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ── Pre-created test accounts ─────────────────────────────────
# These must exist in Supabase before running the test suite.
# Create them once via the Register page or Supabase dashboard.
TEST_CUSTOMER_EMAIL=test_customer@example.com
TEST_CUSTOMER_PASSWORD=Test@1234!

TEST_PROVIDER_EMAIL=test_provider@example.com
TEST_PROVIDER_PASSWORD=Test@1234!

# ── Registration test seed ─────────────────────────────────────
# Random-enough base; tests append a timestamp to avoid collisions.
TEST_REGISTER_EMAIL_BASE=e2e_reg
TEST_REGISTER_PASSWORD=E2eTest@9876!

# ── Browser settings ──────────────────────────────────────────
# Set to "true" to run Chrome with a visible window (useful for debugging)
SELENIUM_HEADLESS=true
# Set window size for screenshots / responsive layout
SELENIUM_WINDOW_WIDTH=1440
SELENIUM_WINDOW_HEIGHT=900
